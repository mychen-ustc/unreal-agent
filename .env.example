# ---- 模型供应商：自定义 / OpenAI-compatible 统一网关 ----
# 只配置 base_url + model_name（+ 可选 api_key）即可按需调用任意模型。
# 与本项目 techdesign 的 LiteLLM 封装（orchestrator/config/models.yaml）对接。

# 必填：供应商端点。
#  · 统一代理网关（one-api / new-api / LiteLLM proxy）：http://<gateway>:PORT/v1
#  · 兼容 OpenAI 的直连/内网模型：http://<host>:PORT/v1
LLM_BASE_URL=http://127.0.0.1:8787/v1

# 可选：上游需要鉴权时填（统一网关通常只需一个主 key）。
LLM_API_KEY=

# ---- 模型路由（三档，均可覆盖，默认见 orchestrator/config/models.yaml）----
MODEL_STRONG=     # 复杂推理：玩法设计 / PCG 参数规划 / 代码生成 / 评审
MODEL_DEFAULT=    # 主力：多数 Agent 任务 / Tool 调用 / GDD 撰写
MODEL_FAST=       # 简单/高频：格式化 / 摘要 / 分类 / 命名校验

# ---- 可观测性（P1+ 再填）----
# OTLP_ENDPOINT=http://127.0.0.1:4318

# ---- 命令行 / CLI 令牌（可无）----
# CLI_TOKEN=

# 说明：本文件仅作模板，可提交进 Git；真实密钥请复制为 .env（已 gitignore）后填写。
